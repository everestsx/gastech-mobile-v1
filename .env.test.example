# Test environment variables for Playwright
# ──────────────────────────────────────────
# Copy this file to .env.test and fill in real values.
# NEVER commit .env.test to the repository!
#
# See docs/PLAYWRIGHT_TESTING.md for full instructions.

# URL of the Expo web server (used by Playwright)
PLAYWRIGHT_BASE_URL=http://localhost:8081

# Your backend Odoo API URL
API_BASE_URL=https://your-odoo-server.com

# Driver barcode/code for automated login tests
# This should be a dedicated QA test account — not a real driver
TEST_DRIVER_CODE=your_test_driver_code_here
