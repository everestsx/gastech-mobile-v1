{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "types": [
            "node",
            "@wdio/globals/types",
            "@wdio/mocha-framework"
        ],
        "noEmit": true,
        "resolveJsonModule": true
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "../node_modules",
        "../android",
        "../ios"
    ]
}