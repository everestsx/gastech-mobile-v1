{
  "name": "gastechmobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "run:android": "npx expo run:android",
    "android:assemble-debug": "cd android && gradlew.bat clean assembleDebug",
    "prebuild:android": "npx expo prebuild --platform android",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "test:e2e:smoke": "wdio run e2e/wdio.conf.ts --spec specs/smoke/*.spec.ts",
    "test:e2e:auth": "wdio run e2e/wdio.conf.ts --spec specs/auth/*.spec.ts",
    "test:e2e:nav": "wdio run e2e/wdio.conf.ts --spec specs/navigation/*.spec.ts",
    "test:e2e:api": "wdio run e2e/wdio.conf.ts --spec specs/api/*.spec.ts",
    "test:e2e:journey": "wdio run e2e/wdio.conf.ts --spec specs/journeys/*.spec.ts",
    "appium:start": "appium --relaxed-security",
    "appium:inspect": "npx start-appium-inspector"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native/virtualized-lists": "0.81.5",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.11.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.7",
    "expo-camera": "^17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "^18.2.1",
    "expo-print": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "i18next": "^26.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.4",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@wdio/allure-reporter": "^9.14.0",
    "@wdio/appium-service": "^9.14.0",
    "@wdio/cli": "^9.14.0",
    "@wdio/local-runner": "^9.14.0",
    "@wdio/mocha-framework": "^9.14.0",
    "@wdio/spec-reporter": "^9.14.0",
    "appium": "^3.4.2",
    "appium-uiautomator2-driver": "^7.2.2",
    "babel-preset-expo": "^54.0.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "webdriverio": "^9.14.0"
  },
  "overrides": {
    "react-native-appwrite": {
      "expo-file-system": "18.*.*",
      "react-native": ">=0.76.7 <1.0.0"
    }
  },
  "private": true
}
