{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Expo (Android)",
      "cwd": "${workspaceFolder}",
      "type": "reactnative",
      "request": "attach",
      "port": 8081
    },
    {
      "name": "Debug Android (Expo)",
      "cwd": "${workspaceFolder}",
      "type": "reactnative",
      "request": "launch",
      "platform": "android"
    },
    {
      "name": "Run Android with JS debugger",
      "cwd": "${workspaceFolder}",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--android"],
      "console": "integratedTerminal"
    }
  ]
}
