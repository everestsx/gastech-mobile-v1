{
  "expo": {
    "name": "GasTechMobile",
    "slug": "GasTechMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/AppLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ED5D1A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gastech.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcon.png",
        "backgroundColor": "#ED5D1A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow GasTech to scan customer QR codes" }]
    ],
    "extra": {
      "eas": {
        "projectId": "9521d75d-13dc-49e5-8793-2022463e75c5"
      }
    }
  }
}
